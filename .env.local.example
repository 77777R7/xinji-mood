OPENAI_API_KEY=
MOOD_AI_SERVER_PORT=8084

# Client-side: where the app calls the Rora server.
# Leave unset to use the page's own hostname on MOOD_AI_SERVER_PORT.
# EXPO_PUBLIC_MOOD_AI_SERVER_URL=https://rora-api.example.com
EXPO_PUBLIC_MOOD_AI_SERVER_PORT=8084
EXPO_PUBLIC_MOOD_AI_TIMEOUT_MS=30000
MOOD_AI_STT_MODEL=gpt-4o-mini-transcribe
MOOD_AI_TTS_MODEL=gpt-4o-mini-tts
MOOD_AI_TTS_VOICE=marin
MOOD_AI_TTS_SPEED=1.10
MOOD_AI_TTS_RESPONSE_FORMAT=wav
MOOD_AI_EXTRACTION_MODEL=gpt-5.4-mini
MOOD_AI_MODERATION_MODEL=omni-moderation-latest
